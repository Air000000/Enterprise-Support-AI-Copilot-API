# Bailian / DashScope API config
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-plus

# Dedicated Singapore rerank config; no fallback to chat/embedding settings.
DASHSCOPE_RERANK_API_KEY=your_singapore_dashscope_api_key_here
DASHSCOPE_RERANK_BASE_URL=https://your_workspace_id.ap-southeast-1.maas.aliyuncs.com/compatible-api/v1

# Opt-in /rag/search only. Sends tenant-filtered candidate bodies to the rerank provider.
# Default ask and Ticket Agent remain Dense. Leave disabled until data egress is approved.
RAG_HYBRID_SEARCH_ENABLED=false

# Experimental /rag/ask: also requires search enabled and explicit v5_3_experimental request policy.
# Dedicated Phase B credentials below are mandatory for runtime ask (no fallback).
RAG_HYBRID_ASK_ENABLED=false

# Dedicated Singapore key for the refusal Phase B classifier; mandatory for experimental runtime ask.
# Offline Phase B runners may fall back to the rerank key; runtime ask never does.
DASHSCOPE_PHASE_B_API_KEY=
DASHSCOPE_PHASE_B_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Database config
DATABASE_URL=sqlite:///data/todos.db

# SQL log config
SQL_ECHO=true

EMBEDDING_MODEL=text-embedding-v4

# Optional Docker-only proxy config. Use host.docker.internal, not 127.0.0.1.
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,::1
